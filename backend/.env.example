# ----------------------------------------------------------------
# 로컬 개발 예시 (.env.example → 복사 후 .env로 사용)
# ----------------------------------------------------------------

# [방식 A] 로컬 MariaDB 직접 실행 시
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/maple_guild_app?charset=utf8mb4

# [방식 B] 로컬에서 Cloudtype 외부 주소로 붙을 때 (로컬 DB 없을 때 편의용)
# DATABASE_URL=mysql+pymysql://maple_app:password@svc.sel3.cloudtype.app:31282/maple_guild_app?charset=utf8mb4

# ★ 운영(Cloudtype 배포)에서는 이 파일 대신 서비스 환경변수에 아래를 설정:
# DATABASE_URL=mysql+pymysql://maple_app:password@mariadb:3306/maple_guild_app?charset=utf8mb4

DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/maple_guild_app?charset=utf8mb4

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379/0

DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

CHAT_MAX_MESSAGE_LENGTH=500

UVICORN_WORKERS=1
UVICORN_RELOAD=false
WEBSOCKET_LOG_LEVEL=INFO
SOCKETIO_VERBOSE_LOGS=false